# =============================================================================
# Sypho.io — Environment Variables Template
# =============================================================================
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` or any file containing real secrets.
#
# Production secrets must be stored in your deployment platform's secret manager
# (e.g., Vercel Environment Variables, AWS Secrets Manager).
#
# GDPR NOTE: This application must only use EU-region infrastructure.
# Supabase project must be configured on the `eu-central-1` region.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — Public (safe for browser)
# -----------------------------------------------------------------------------
# Your Supabase project URL (found in: Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anonymous/public key — protected by Row Level Security (RLS)
# This key is safe to expose to the browser; RLS enforces data isolation.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# -----------------------------------------------------------------------------
# SUPABASE — Server-only (NEVER expose to browser)
# -----------------------------------------------------------------------------
# Service Role key — bypasses all RLS policies. Handle with extreme care.
# Only used in privileged server-side contexts (background jobs, webhooks).
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT secret for verifying Supabase-issued tokens server-side
SUPABASE_JWT_SECRET=your-jwt-secret

# Direct PostgreSQL connection (for migrations and seeds — server/CLI only)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application-level encryption key (32 bytes, generate with: openssl rand -hex 32)
# Used for encrypting sensitive fields at the application layer before DB storage.
ENCRYPTION_KEY=replace-with-64-character-hex-string

# -----------------------------------------------------------------------------
# OPTIONAL: Feature flags & integrations
# -----------------------------------------------------------------------------
# Sentry DSN for error monitoring (EU-hosted Sentry instance preferred)
# NEXT_PUBLIC_SENTRY_DSN=

# Stripe publishable key (for subscription billing)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe secret key (server-only)
# STRIPE_SECRET_KEY=

# Resend API key (for transactional email)
# RESEND_API_KEY=
